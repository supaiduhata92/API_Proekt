@page
@model API_Proekt.Pages.Facts.IndexModel

<h2>Fun Facts</h2>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Cat fact</h5>
                @if (Model.CatFact == null)
                {
                    <p class="card-text text-muted">Unable to load a cat fact right now.</p>
                }
                else
                {
                    <p class="card-text">@Model.CatFact.Fact</p>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Dog fact</h5>
                @if (Model.DogFact == null)
                {
                    <p class="card-text text-muted">Unable to load a dog fact right now.</p>
                }
                else
                {
                    <p class="card-text">@Model.DogFact.Fact</p>
                }
            </div>
        </div>
    </div>
</div>