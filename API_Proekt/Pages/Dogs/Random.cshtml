@page
@model API_Proekt.Pages.Dogs.RandomModel

<h2>Random Dog</h2>

<form method="post" asp-page-handler="Fetch">
    <button type="submit" class="btn btn-primary mb-3">Get random dog</button>
</form>

@if (!ModelState.IsValid)
{
    <div class="alert alert-danger">
        Something went wrong fetching the dog. Try again.
        @foreach (var err in ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@err.ErrorMessage</div>
        }
    </div>
}

@if (Model.Dog != null)
{
    <div class="card" style="max-width:540px;">
        <img src="@Model.Dog.ImageUrl" class="card-img-top" alt="Dog image" />
        <div class="card-body">
            <h5 class="card-title">Breed: @Model.Dog.BreedName</h5>
            <p class="card-text">@Model.Dog.BreedDescription</p>

            <button id="btn-add-fav" class="btn btn-success">Add to favorites</button>
            <button id="btn-ai" class="btn btn-outline-info ms-2">Generate breed info (AI)</button>

            <div id="ai-desc" class="mt-3"></div>
        </div>
    </div>

    <div id="dog-message" class="mt-3"></div>

    <script>
        (function () {
            const addBtn = document.getElementById('btn-add-fav');
            const aiBtn = document.getElementById('btn-ai');
            const msg = document.getElementById('dog-message');
            const aiDesc = document.getElementById('ai-desc');

            // helper to show a message
            function showMessage(html, type = 'info') {
                msg.innerHTML = `<div class="alert alert-${type}">${html}</div>`;
            }

            addBtn.addEventListener('click', async function (e) {
                e.preventDefault();
                const token = sessionStorage.getItem('jwt');
                if (!token) {
                    msg.innerHTML = '<div class="alert alert-warning">You must be logged in to add favorites.</div>';
                    return;
                }

                const payload = {
                    animalType: 'Dog',
                    breed: '@(Model.Dog.BreedName.Replace("'", "\\'"))',
                    imageUrl: '@(Model.Dog.ImageUrl)',
                    note: '@(Model.Dog.BreedDescription.Replace("'", "\\'"))'
                };

                try {
                    addBtn.disabled = true;
                    showMessage('Saving favorite...', 'info');
                    const res = await fetch('/api/favorites', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Authorization': 'Bearer ' + token
                        },
                        body: JSON.stringify(payload)
                    });
                    if (!res.ok) {
                        const txt = await res.text();
                        showMessage('Failed to save favorite: ' + txt, 'danger');
                        addBtn.disabled = false;
                        return;
                    }
                    showMessage('Saved to favorites.', 'success');
                } catch (err) {
                    console.error(err);
                    showMessage('Unexpected error saving favorite.', 'danger');
                    addBtn.disabled = false;
                }
            });

            aiBtn.addEventListener('click', async function (e) {
                e.preventDefault();
                aiDesc.innerHTML = '';
                showMessage('Generating AI description…', 'info');
                aiBtn.disabled = true;

                try {
                    const res = await fetch('/api/ai/breed-info', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ breedName: '@(Model.Dog.BreedName.Replace("'", "\\'"))' })
                    });

                    if (!res.ok) {
                        const txt = await res.text();
                        showMessage('AI request failed: ' + txt, 'danger');
                        aiBtn.disabled = false;
                        return;
                    }

                    const data = await res.json();
                    aiDesc.innerHTML = `<h6>AI description (source: ${data.source})</h6><p>${data.text}</p>`;
                    showMessage('AI content generated.', 'success');
                } catch (err) {
                    console.error(err);
                    showMessage('Unexpected AI error.', 'danger');
                } finally {
                    aiBtn.disabled = false;
                }
            });
        })();
    </script>
}