@page
@model API_Proekt.Pages.Favorites.IndexModel

@{
    ViewData["Title"] = "My Favorites";
}

<h1>My Favorites</h1>

<div class="mb-3">
    <p class="text-muted"> Потвърдете отново парола и име за да видите запазените фаворити</p>

    <form method="post" asp-page-handler="Authenticate" class="row g-2 align-items-center" style="max-width:480px;">
        <div class="col-auto">
            <label class="visually-hidden" for="FormUsername">Username</label>
            <input asp-for="FormUsername" class="form-control" placeholder="Потребителско име" />
        </div>
        <div class="col-auto">
            <label class="visually-hidden" for="FormPassword">Password</label>
            <input asp-for="FormPassword" class="form-control" placeholder="Парола" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Покажи запазени</button>
        </div>
    </form>

    @if (!ModelState.IsValid)
    {
        <div class="mt-3">
            <div class="alert alert-danger">
                @foreach (var err in ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@err.ErrorMessage</div>
                }
            </div>
        </div>
    }
</div>

@if (!string.IsNullOrEmpty(Model.AuthenticatedUsername))
{
    <div class="mb-3 d-flex align-items-center">
        <strong class="me-2">Showing favorites for:</strong> @Model.AuthenticatedUsername

        <form method="post" asp-page-handler="ClearAuth" class="ms-3">
            <button type="submit" class="btn btn-outline-secondary btn-sm">Clear</button>
            @* Include the antiforgery token *@
            @Html.AntiForgeryToken()
        </form>
    </div>
}

@if (Model.Favorite == null || !Model.Favorite.Any())
{
    <div class="alert alert-info">No favorites to show (or not authenticated yet).</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>#</th>
                <th>Type</th>
                <th>Breed</th>
                <th>Image</th>
                <th>Note</th>
                <th>Created</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        @for (int i = 0; i < Model.Favorite.Count; i++)
        {
            var item = Model.Favorite[i];
            <tr>
                <td>@(i + 1)</td>
                <td>@item.AnimalType</td>
                <td>@item.Breed</td>
                <td>
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" style="max-width:120px" alt="favorite image" />
                    }
                </td>
                <td>@item.Note</td>
                <td>@item.CreatedAt.ToLocalTime().ToString("g")</td>
                <td><a asp-page="./Details" asp-route-id="@item.Id">Details</a></td>
            </tr>
        }
        </tbody>
    </table>
}
