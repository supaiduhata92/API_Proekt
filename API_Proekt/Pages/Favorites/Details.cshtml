@page
@model API_Proekt.Pages.Favorites.DetailsModel

<h2>Favorite details</h2>

@if (Model.Favorite == null)
{
    <div class="alert alert-warning">Favorite not found.</div>
}
else
{
    <div class="card mb-3" style="max-width:720px;">
        @if (!string.IsNullOrEmpty(Model.Favorite.ImageUrl))
        {
            <img src="@Model.Favorite.ImageUrl" class="card-img-top" alt="Favorite image" />
        }
        <div class="card-body">
            <h5 class="card-title">Breed: @Model.Favorite.Breed</h5>
            <p class="card-text">@Model.Favorite.Note</p>

            <ul class="list-unstyled small text-muted">
                <li><strong>Type:</strong> @Model.Favorite.AnimalType</li>
                <li><strong>Added:</strong> @Model.Favorite.CreatedAt.ToLocalTime().ToString("g")</li>
            </ul>

            <a asp-page="./Index" class="btn btn-secondary">Back to list</a>
        </div>
    </div>
}
