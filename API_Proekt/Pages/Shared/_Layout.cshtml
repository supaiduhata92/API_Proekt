<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - API_Proekt</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/API_Proekt.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">API_Proekt</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Privacy">Privacy</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/cats/random">Get a random cat!</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/dogs/random">Get a random dog</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/favorites/index">фаворити</a>
                        </li>
                    </ul>

                    <!-- Auth links (Login / Register) -->
                    <ul class="navbar-nav" id="nav-auth">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Account/Login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Account/Register">Register</a>
                        </li>
                    </ul>

                    <!-- Logged in user (hidden by default) -->
                    <ul class="navbar-nav" id="nav-user" style="display:none;">
                        <li class="nav-item">
                            <span class="nav-link text-dark">Hello, <strong id="nav-username"></strong></span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="#" id="nav-logout">Logout</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - API_Proekt - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Small client-side helper to toggle auth UI based on sessionStorage JWT.
        (function () {
            function getUsernameFromJwt(token) {
                if (!token) return null;
                try {
                    var parts = token.split('.');
                    if (parts.length < 2) return null;
                    var payload = parts[1];
                    payload = payload.replace(/-/g, '+').replace(/_/g, '/');
                    while (payload.length % 4) payload += '=';
                    var json = atob(payload);
                    var obj = JSON.parse(json);
                    return obj.unique_name || obj.name || obj['http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name'] || null;
                } catch (e) {
                    console.warn('Failed to parse JWT', e);
                    return null;
                }
            }

            try {
                var token = sessionStorage.getItem('jwt');
                var username = getUsernameFromJwt(token);

                var navAuth = document.getElementById('nav-auth');
                var navUser = document.getElementById('nav-user');
                var navUsername = document.getElementById('nav-username');
                var navLogout = document.getElementById('nav-logout');

                if (username) {
                    if (navAuth) navAuth.style.display = 'none';
                    if (navUser) navUser.style.display = 'flex';
                    if (navUsername) navUsername.textContent = username;
                } else {
                    if (navAuth) navAuth.style.display = 'flex';
                    if (navUser) navUser.style.display = 'none';
                }

                // logout: call server to clear any server-side cookies, then clear client storage and reload.
                async function doLogout() {
                    try {
                        // Call server logout to delete favorites_auth cookie (HttpOnly cookie)
                        await fetch('/api/auth/logout', {
                            method: 'POST',
                            credentials: 'same-origin', // ensure cookies are sent
                            headers: { 'Content-Type': 'application/json' }
                        });
                    } catch (e) {
                        // ignore network errors; we still clear client-side tokens
                        console.warn('Server logout failed', e);
                    } finally {
                        // Clear client-side auth artifacts
                        sessionStorage.removeItem('jwt');
                        sessionStorage.removeItem('favoritesPosted');
                        // reload so UI updates
                        location.reload();
                    }
                }

                window.logout = doLogout;

                if (navLogout) {
                    navLogout.addEventListener('click', function (e) {
                        e.preventDefault();
                        doLogout();
                    });
                }
            } catch (e) {
                console.error('Auth UI initialization failed', e);
            }
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
